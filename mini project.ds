			)
			actual_check_in_date
			(
    			type = date
				displayname = "Actual Check In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			actual_check_in_time
			(
    			type = time
				displayname = "Actual Check In Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_guests
			(
				type = number
				displayname = "Number Of Guests"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_verification_status
			(
				type = picklist
				displayname = "ID Verification Status"
				values = {"Verified","Exempt","Not Verified"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			key_issued
			(
    			type = checkbox
				displayname = "Key Or Access Card Issued"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			staff_member
			(
				type = picklist	
				displayname = "Staff Member"
				values  = staff_profile.ID
    			displayformat = [staff_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_notes
			(
    			type = textarea
				displayname = "Check In Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Check-In Initiated","ID Verification Pending","Check-In Cancelled","ID Verified","ID Verification Failed","Key Issuance Pending","Check-In Denied","Keys Issued","Check-In Completed","Guest Stay Active","Check-Out Initiated","Check-Out Completed"}
			}
