		workflow
		{
		form
		{
			auto_calculate_booking_total as "Auto-calculate Booking Total"
			{
				type =  form
				form = booking_record

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Calculate base amount from number of nights and room price per night
										baseAmount = input.number_of_nights * input.room_price_per_night;
										// Calculate discount amount if discount is provided
										discountAmount = input.discount_amount;
										// Calculate extra charges
										extraCharges = input.extra_charges;
										// Calculate tax amount (assuming 18% tax rate, adjust if needed)
										taxAmount = (baseAmount - discountAmount + extraCharges) * 0.18;
										// Calculate final booking amount
										finalBookingAmount = baseAmount - discountAmount + extraCharges + taxAmount;
										// Set the calculated values to the form fields
										input.final_booking_amount = finalBookingAmount;
										input.tax_amount = taxAmount;
						)
					}
				}

			}
			vip_guest_welcome_email as "VIP Guest Welcome Email"
			{
				type =  form
				form = booking_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the guest profile linked to the booking
										guestRecord = guest_profile[ID == input.guest];
										// Check if the guest is a VIP
										if(guestRecord.is_vip == true)
										{
											// Get guest details
											guestEmail = guestRecord.email;
											guestName = guestRecord.full_name.first_name;
											bookingId = input.booking_id;
											checkInDate = input.check_in_date;
											roomName = input.room.room_name;
											// Validate email is not null or empty
											if(guestEmail.isNull() && guestEmail.isEmpty())
											{
												info "Guest email is missing for VIP: " + guestName;
											}
											else
											{
												// Send welcome email to VIP guest
												sendmail
												[
													from :zoho.loginuserid
													to :guestEmail
													subject :"Welcome to Our Hotel - Booking Confirmation #" + bookingId.toString()
													message :"Dear " + guestName + ",\n\nThank you for choosing our hotel!\n\nYour booking has been confirmed with the following details:\n\nBooking ID: " + bookingId.toString() + "\nCheck-in Date: " + checkInDate.toString() + "\nRoom: " + roomName + "\n\nWe look forward to welcoming you!\n\nBest regards,\nHotel Management Team"
												]
											}
										}
						)
					}
				}

			}
		}




