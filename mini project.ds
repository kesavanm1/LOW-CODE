	reports
	{
		list booking_record_Report
		{
			displayName = "All Records"
			show all rows from booking_record    
			(
				booking_id as "Booking Id"
				booking_date as "Booking Date"
				guest as "Guest"
				room as "Room"
				check_in_date as "Check In Date"
				check_out_date as "Check Out Date"
				number_of_adults as "Number Of Adults"
				number_of_children as "Number Of Children"
				number_of_rooms as "Number Of Rooms"
				meal_plan as "Meal Plan"
				booking_source as "Booking Source"
				special_requests as "Special Requests"
				room_price_per_night as "Room Price Per Night"
				(
					display = total,average,min,max	
				)
				number_of_nights as "Number Of Nights"
				extra_charges as "Extra Charges"
				(
					display = total,average,min,max	
				)
				discount_amount as "Discount Amount"
				(
					display = total,average,min,max	
				)
				tax_amount as "Tax Amount"
				(
					display = total,average,min,max	
				)
				final_booking_amount as "Final Booking Amount"
				(
					display = total,average,min,max	
				)
				payment_status as "Payment Status"
				booking_status as "Booking Status"
				staff_member as "Staff Member"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (booking_source == "Corporate")
				fields = [booking_source]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (booking_source == "Phone")
				fields = [booking_source]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (booking_source == "Travel Agent")
				fields = [booking_source]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (booking_source == "Walk In")
				fields = [booking_source]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban booking_record_by_booking_status
		{
			displayName = "Booking Statuses"
			show all rows from booking_record    
			(
				booking_id as "Booking Id"
				booking_date as "Booking Date"
				guest as "Guest"
				room as "Room"
				check_in_date as "Check In Date"
				check_out_date as "Check Out Date"
				number_of_adults as "Number Of Adults"
				number_of_children as "Number Of Children"
				number_of_rooms as "Number Of Rooms"
				meal_plan as "Meal Plan"
				booking_source as "Booking Source"
				special_requests as "Special Requests"
				room_price_per_night as "Room Price Per Night"
				(
					display = total,average,min,max	
				)
				number_of_nights as "Number Of Nights"
				extra_charges as "Extra Charges"
				(
					display = total,average,min,max	
				)
				discount_amount as "Discount Amount"
				(
					display = total,average,min,max	
				)
				tax_amount as "Tax Amount"
				(
					display = total,average,min,max	
				)
				final_booking_amount as "Final Booking Amount"
				(
					display = total,average,min,max	
				)
				payment_status as "Payment Status"
				booking_status as "Booking Status"
				staff_member as "Staff Member"
			)
			options
			(
	 			display field = booking_status
	 		)
		}
		list check_in_log_Report
		{
			displayName = "Check In Log Report"
			show all rows from check_in_log    
			(
				booking as "Booking"
				guest_name  as "Guest Name"
				room_number as "Room Number"
				actual_check_in_date as "Actual Check In Date"
				actual_check_in_time as "Actual Check In Time"
				number_of_guests as "Number Of Guests"
				id_verification_status as "ID Verification Status"
				key_issued as "Key Or Access Card Issued"
				staff_member as "Staff Member"
				check_in_notes as "Check In Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (id_verification_status == "Exempt")
				fields = [id_verification_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (id_verification_status == "Not Verified")
				fields = [id_verification_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (id_verification_status == "Verified")
				fields = [id_verification_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban check_in_log_by_id_verification_status
		{
			displayName = "Id Verification Statuses"
			show all rows from check_in_log    
			(
				booking as "Booking"
				guest_name  as "Guest Name"
				room_number as "Room Number"
				actual_check_in_date as "Actual Check In Date"
