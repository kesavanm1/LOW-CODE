				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			"Guest"
			{
				name = "Guest"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Browse available rooms and submit booking requests \n"
				ModulePermissions
				{
					guest_profile
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							guest_profile_by_guest_category={"View"}
							guest_profile_Report={"View"}
						}
					}
					payment_transaction
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							payment_transaction_Report={"View"}
							payment_transaction_by_payment_status={"View"}
						}
					}
					booking_record
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							booking_record_Report={"View"}
							booking_record_by_booking_status={"View"}
						}
					}
					guest_feedback
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							guest_feedback_Report={"View"}
							guest_feedback_by_follow_up_status={"View"}
						}
					}
				}
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


