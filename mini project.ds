 application "Hotel Room Booking System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form booking_record
		{
			displayname = "Booking Record"
			success message = "Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking_id
			(
    			type = autonumber
				displayname = "Booking Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_date
			(
    			type = date
				displayname = "Booking Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest
			(
				type = picklist	
				displayname = "Guest"
				values  = guest_profile.ID
    			displayformat = [guest_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			room
			(
				type = picklist	
				displayname = "Room"
				values  = room_master.ID
    			displayformat = [room_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_date
			(
    			type = date
				displayname = "Check In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_out_date
			(
    			type = date
				displayname = "Check Out Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_adults
			(
				type = number
				displayname = "Number Of Adults"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_children
			(
				type = number
				displayname = "Number Of Children"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_rooms
			(
				type = number
				displayname = "Number Of Rooms"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			meal_plan
			(
				type = picklist
				displayname = "Meal Plan"
				values = {"Breakfast Included","Half Board","Full Board","Room Only"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_source
			(
				type = picklist
				displayname = "Booking Source"
				values = {"Phone","Corporate","Travel Agent","Website","Walk In"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_requests
			(
    			type = textarea
				displayname = "Special Requests"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_price_per_night
			(
				displayname = "Room Price Per Night"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_nights
			(
				type = number
				displayname = "Number Of Nights"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			extra_charges
			(
				displayname = "Extra Charges"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			discount_amount
			(
				displayname = "Discount Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			tax_amount
			(
				displayname = "Tax Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			final_booking_amount
			(
				displayname = "Final Booking Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Failed","Paid","Pending","Partially Paid","Refunded"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_status
			(
				type = picklist
				displayname = "Booking Status"
				values = {"No Show","Checked In","Confirmed","Cancelled","Pending","Checked Out"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			staff_member
			(
				type = picklist	
				displayname = "Staff Member"
				values  = staff_profile.ID
    			displayformat = [staff_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
